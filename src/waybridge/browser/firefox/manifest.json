{
  "manifest_version": 2,
  "name": "Waybridge Page Export",
  "version": "3.6.0",
  "description": "Export the current section as ordered text and a full visual reference to your paired PC.",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-export@waybridge.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "extract.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Waybridge — экспорт раздела",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
