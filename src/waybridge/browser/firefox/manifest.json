{
  "manifest_version": 2,
  "name": "Nordic Reader",
  "version": "3.6.7",
  "description": "Independent Nord theme and automatic active Google Forms export to your paired PC.",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-export@waybridge.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "browsingActivity"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "page-url.js",
      "page-snapshot.js",
      "page-identity.js",
      "background.js",
      "nordic.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Nordic Reader — тема и экспорт Forms",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
